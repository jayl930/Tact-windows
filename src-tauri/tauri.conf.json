{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tact",
  "version": "0.1.0",
  "identifier": "com.tact.windows",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Tact",
        "label": "main",
        "width": 380,
        "height": 560,
        "minWidth": 380,
        "minHeight": 560,
        "maxWidth": 380,
        "maxHeight": 560,
        "resizable": false,
        "decorations": true,
        "visible": true,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/jayl930/Tact-windows/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVBRThGNEM2MUFGMTBBMEEKUldRS0N2RWF4dlRvV2p0SGdqV2NyMTZtdXZzTHlxVCtCQjBwRUdRMGhUdURyMjRkOXZLS1BOQXgK"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
